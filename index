        // Bracket Generator Algorithms
        function partitionPlayersEvenly(playersList, targetSize) {
            const total = playersList.length;
            if (total === 0) return [];

            let numTables = Math.ceil(total / targetSize);
            let tables = Array.from({ length: numTables }, () => []);

            const baseSize = Math.floor(total / numTables);
            const remainder = total % numTables;

            let playerIndex = 0;
            for (let t = 0; t < numTables; t++) {
                const countForThisTable = baseSize + (t < remainder ? 1 : 0);
                for (let i = 0; i < countForThisTable; i++) {
                    if (playerIndex < total) {
                        tables[t].push(playersList[playerIndex]);
                        playerIndex++;
                    }
                }
            }
            return tables;
        }

        function createTableStructure(tableIdx, playerList, isFinals = false) {
