<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>King of Tokyo - Tournament Manager</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        tokyo: {
                            green: '#10B981',
                            dark: '#0F172A',
                            purple: '#8B5CF6',
                            amber: '#F59E0B',
                            red: '#EF4444'
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #030712;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #1e293b;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        .kot-range {
            -webkit-appearance: none; appearance: none;
            width: 100%; height: 8px; border-radius: 9999px; outline: none; cursor: pointer;
            background: linear-gradient(to right, #f59e0b 0%, #f59e0b var(--pct, 50%), #1e293b var(--pct, 50%), #1e293b 100%);
            border: 1px solid #334155;
        }
        .kot-range::-webkit-slider-thumb {
            -webkit-appearance: none; appearance: none;
            width: 22px; height: 22px; border-radius: 9999px; cursor: grab;
            background: #fbbf24; border: 3px solid #0f172a; box-shadow: 0 0 0 2px #f59e0b, 0 2px 6px rgba(0,0,0,.5);
        }
        .kot-range::-moz-range-thumb {
            width: 18px; height: 18px; border-radius: 9999px; cursor: grab;
            background: #fbbf24; border: 3px solid #0f172a; box-shadow: 0 0 0 2px #f59e0b;
        }
        .kot-range:focus-visible { box-shadow: 0 0 0 3px rgba(245,158,11,.35); }
        .kot-range:active::-webkit-slider-thumb { cursor: grabbing; }
        .drag-over {
            border-color: #38bdf8 !important;
            background-color: rgba(56, 189, 248, 0.1) !important;
        }
        .dragging {
            opacity: 0.4;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col antialiased selection:bg-amber-500 selection:text-slate-950">

    <!-- Header Navigation (Non-sticky, Clean single line on desktop, two lines on mobile) -->
    <header class="bg-slate-900 border-b border-slate-800 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between gap-3">
            
            <!-- Logo & Title -->
            <div class="flex items-center min-w-0">
                <div class="flex items-center gap-3">
                    <div class="bg-gradient-to-br from-amber-500 to-amber-700 text-slate-950 p-2.5 rounded-xl font-black text-xl tracking-wider shadow-lg shadow-amber-500/20 flex items-center justify-center w-10 h-10 shrink-0">
                        <i class="fa-solid fa-crown text-slate-950"></i>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 min-w-0">
                        <h1 class="text-xl font-black tracking-tight text-white leading-none">
                            KING OF TOKYO
                        </h1>
                        <span class="text-xs bg-amber-500/10 text-amber-400 border border-amber-500/20 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider">Tournament Manager</span>
                    </div>
                </div>
            </div>

            <!-- Desktop Actions -->
            <div class="flex items-center shrink-0">

                <!-- Action Buttons Dropdown (Single unified menu trigger) -->
                <div class="relative">
                    <button onclick="window.toggleHeaderMenu(event)" class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-slate-300 transition-colors flex items-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-bars"></i>
                        <span>Menu</span>
                        <i class="fa-solid fa-chevron-down text-[10px] text-slate-400"></i>
                    </button>

                    <!-- Dropdown Menu -->
                    <div id="header-dropdown-menu" class="hidden absolute right-0 mt-2 w-48 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl z-50 py-1 text-xs divide-y divide-slate-800">
                        <div class="py-1">
                            <button onclick="window.openRulesModal(); window.closeHeaderMenu();" class="w-full text-left px-4 py-2 hover:bg-slate-800 text-slate-200 font-semibold flex items-center gap-2.5 transition-colors cursor-pointer">
                                <i class="fa-solid fa-book-open text-amber-400 w-4"></i> Tournament Rules
                            </button>
                        </div>
                        <div class="py-1">
                            <button onclick="window.exportTournamentData(); window.closeHeaderMenu();" class="w-full text-left px-4 py-2 hover:bg-slate-800 text-slate-200 font-semibold flex items-center gap-2.5 transition-colors cursor-pointer">
                                <i class="fa-solid fa-download text-blue-400 w-4"></i> Export Data
                            </button>
                            <button onclick="document.getElementById('import-file-input').click(); window.closeHeaderMenu();" class="w-full text-left px-4 py-2 hover:bg-slate-800 text-slate-200 font-semibold flex items-center gap-2.5 transition-colors cursor-pointer">
                                <i class="fa-solid fa-upload text-emerald-400 w-4"></i> Import Data
                            </button>
                        </div>
                        <div class="py-1">
                            <button onclick="window.openResetModal(); window.closeHeaderMenu();" class="w-full text-left px-4 py-2 hover:bg-rose-500/10 text-rose-400 font-semibold flex items-center gap-2.5 transition-colors cursor-pointer">
                                <i class="fa-solid fa-rotate-left w-4"></i> Reset Tournament
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <input type="file" id="import-file-input" class="hidden" accept=".json" onchange="window.importTournamentData(event)">
        </div>
    </header>

    <!-- Main Content Layout -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Left Column: Setup & Roster Management (4 Cols) - Mobile order changes dynamically once started -->
        <section id="sidebar-setup-section" class="lg:col-span-4 flex flex-col gap-6 order-2 lg:order-1">
            
            <!-- Tournament Settings Card -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-hidden">
                <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
                    <h2 class="text-base font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-amber-500"></i> Settings
                    </h2>
                    <button id="btn-generate-r1" type="button" onclick="window.generateRound1()" class="px-3 py-1.5 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-extrabold text-xs rounded-lg shadow-lg shadow-emerald-950/50 transition-all flex items-center justify-center gap-1.5 cursor-pointer shrink-0">
                        <i class="fa-solid fa-play"></i> Generate Tournament
                    </button>
                </div>

                <div class="space-y-5">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <label for="setting-table-size" class="text-xs font-bold text-slate-400 uppercase tracking-wider"><i class="fa-solid fa-users text-slate-500 mr-1"></i> Players per Table</label>
                            <span id="badge-table-size" class="px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-extrabold">5</span>
                        </div>
                        <input type="range" id="setting-table-size" class="kot-range" min="2" max="6" step="1" value="5" oninput="window.updateSettings()">
                        <div class="flex justify-between text-[10px] font-bold text-slate-500 px-1 mt-1.5"><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span></div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <label class="text-xs font-bold text-slate-400 uppercase tracking-wider"><i class="fa-solid fa-flag-checkered text-slate-500 mr-1"></i> Prelim Rounds</label>
                            <span id="badge-max-rounds" class="px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-extrabold">3 rounds</span>
                        </div>
                        <input type="hidden" id="setting-max-rounds" value="3">
                        <div class="grid grid-cols-5 gap-2">
                            <button type="button" data-rounds="1" onclick="window.setPrelimRounds(1)" class="round-opt flex flex-col items-center gap-1 py-2 rounded-xl border transition-colors cursor-pointer">
                                <span class="text-base font-black leading-none">1</span>
                                <span class="flex gap-0.5 text-[8px]"><i class="fa-solid fa-flag"></i></span>
                            </button>
                            <button type="button" data-rounds="2" onclick="window.setPrelimRounds(2)" class="round-opt flex flex-col items-center gap-1 py-2 rounded-xl border transition-colors cursor-pointer">
                                <span class="text-base font-black leading-none">2</span>
                                <span class="flex gap-0.5 text-[8px]"><i class="fa-solid fa-flag"></i><i class="fa-solid fa-flag"></i></span>
                            </button>
                            <button type="button" data-rounds="3" onclick="window.setPrelimRounds(3)" class="round-opt flex flex-col items-center gap-1 py-2 rounded-xl border transition-colors cursor-pointer">
                                <span class="text-base font-black leading-none">3</span>
                                <span class="flex gap-0.5 text-[8px]"><i class="fa-solid fa-flag"></i><i class="fa-solid fa-flag"></i><i class="fa-solid fa-flag"></i></span>
                            </button>
                            <button type="button" data-rounds="4" onclick="window.setPrelimRounds(4)" class="round-opt flex flex-col items-center gap-1 py-2 rounded-xl border transition-colors cursor-pointer">
                                <span class="text-base font-black leading-none">4</span>
                                <span class="flex gap-0.5 text-[8px]"><i class="fa-solid fa-flag"></i><i class="fa-solid fa-flag"></i><i class="fa-solid fa-flag"></i><i class="fa-solid fa-flag"></i></span>
                            </button>
                            <button type="button" data-rounds="5" onclick="window.setPrelimRounds(5)" class="round-opt flex flex-col items-center gap-1 py-2 rounded-xl border transition-colors cursor-pointer">
                                <span class="text-base font-black leading-none">5</span>
                                <span class="flex gap-0.5 text-[8px]"><i class="fa-solid fa-flag"></i><i class="fa-solid fa-flag"></i><i class="fa-solid fa-flag"></i><i class="fa-solid fa-flag"></i><i class="fa-solid fa-flag"></i></span>
                            </button>
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <label for="setting-round-timer" class="text-xs font-bold text-slate-400 uppercase tracking-wider"><i class="fa-solid fa-stopwatch text-slate-500 mr-1"></i> Match Timer</label>
                            <span id="badge-round-timer" class="px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs font-extrabold">30 min</span>
                        </div>
                        <input type="range" id="setting-round-timer" class="kot-range" min="5" max="60" step="5" value="30" oninput="window.updateSettings()">
                        <div class="relative h-4 mx-[11px] mt-1.5 text-[10px] font-bold text-slate-500"><span class="absolute -translate-x-1/2" style="left:0.00%">5m</span><span class="absolute -translate-x-1/2" style="left:18.18%">15m</span><span class="absolute -translate-x-1/2" style="left:45.45%">30m</span><span class="absolute -translate-x-1/2" style="left:72.73%">45m</span><span class="absolute -translate-x-1/2" style="left:100.00%">60m</span></div>
                    </div>

                </div>
            </div>

            <!-- Player Roster Card -->
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl flex flex-col flex-1">
                <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3">
                    <h2 class="text-base font-bold text-white flex flex-wrap items-center gap-x-2 gap-y-1">
                        <i class="fa-solid fa-users text-amber-500"></i> Player Roster
                        <span id="player-count-badge" class="text-xs bg-slate-800 text-slate-300 font-extrabold px-2 py-0.5 rounded-full border border-slate-700">0</span>
                        <span title="Players are randomly split between tables for Round 1" class="text-[10px] bg-amber-500/10 text-amber-400 border border-amber-500/20 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider whitespace-nowrap"><i class="fa-solid fa-shuffle mr-1"></i>Random Swiss Rounds</span>
                    </h2>
                </div>

                <!-- Add Player Form -->
                <form id="add-player-form" onsubmit="window.handleAddPlayer(event)" class="flex flex-col gap-2 mb-4">
                    <textarea id="player-name-input" rows="2" placeholder="Enter monster name(s)... (comma or new line separated)" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors resize-none"></textarea>
                    <div class="flex items-stretch gap-2">
                        <button type="submit" class="shrink-0 px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm rounded-xl shadow-lg shadow-amber-500/20 transition-all cursor-pointer flex items-center justify-center gap-1.5 whitespace-nowrap">
                            <i class="fa-solid fa-plus"></i> Add Player(s)
                        </button>
                        <button type="button" onclick="window.quickAddSamplePlayers()" class="flex-1 min-w-0 px-2 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-xl border border-slate-700 transition-colors flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i> +4 Monsters (Quick Add)
                        </button>
                    </div>
                </form>

                <!-- Player List Container -->
                <div class="flex-1 overflow-y-auto max-h-[280px] custom-scrollbar pr-1 space-y-2" id="roster-list-container">
                    <!-- Populated via JS -->
                </div>
            </div>
        </section>

        <!-- Right Column: Rounds Control & Dynamic Standings (8 Cols) - Mobile order changes dynamically once started -->
        <section id="main-content-section" class="lg:col-span-8 flex flex-col gap-6 order-1 lg:order-2">

            <!-- Navigation Tabs for Rounds & Standings -->
            <div class="flex flex-col border-b border-slate-800 pb-3 gap-3">
                <div class="flex items-center justify-between" id="tab-controls">
                    <div class="flex gap-2">
                        <button onclick="window.switchTab('rounds')" id="tab-btn-rounds" class="px-4 py-2 text-sm font-bold rounded-xl bg-amber-500 text-slate-950 transition-all flex items-center gap-2 shadow-lg cursor-pointer">
                            <i class="fa-solid fa-gamepad"></i> Active Round & Tables
                        </button>
                        <button onclick="window.switchTab('standings')" id="tab-btn-standings" class="px-4 py-2 text-sm font-bold rounded-xl bg-slate-800 text-slate-400 hover:text-white transition-all flex items-center gap-2 cursor-pointer">
                            <i class="fa-solid fa-list-ol"></i> Leaderboard Standings
                        </button>
                    </div>
                </div>

                <!-- Round Pills Row - Dedicated separate line to prevent squishing -->
                <div id="round-pills-container" class="flex gap-1.5 overflow-x-auto w-full pb-1 custom-scrollbar">
                    <!-- Dynamic round switcher pills -->
                </div>
            </div>

            <!-- TAB 1: ROUNDS VIEW -->
            <div id="view-rounds" class="space-y-6">
                
                <!-- Round Header & Workflows -->
                <div id="round-header" class="hidden bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-hidden">
                    <div class="flex flex-wrap items-center justify-between gap-4 relative z-10">
                        
                        <!-- Title & Clock Badge -->
                        <div class="flex items-center gap-3">
                            <div class="bg-amber-500/20 text-amber-400 p-2.5 rounded-xl border border-amber-500/30">
                                <i class="fa-solid fa-trophy text-xl"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <h2 id="round-title-display" class="text-2xl font-extrabold text-white tracking-tight">Round 1</h2>
                                    <span id="round-status-badge" class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-slate-800 text-slate-400 border border-slate-700 uppercase tracking-wider">
                                        Waiting to Start
                                    </span>
                                </div>
                                <div class="flex items-center gap-2 mt-0.5">
                                    <span id="round-clock" class="font-mono text-2xl font-black text-amber-400 tracking-wider">30:00</span>
                                    <span id="round-timer-state" class="text-xs text-slate-400 font-medium"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Action Control Buttons -->
                        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
                            
                            <!-- Start Round -->
                            <button id="btn-start-round" onclick="window.startCurrentRound()" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-extrabold text-sm shadow-lg shadow-emerald-950/40 transition-all flex items-center gap-2 cursor-pointer transform hover:-translate-y-0.5">
                                <i class="fa-solid fa-play"></i> Start Round
                            </button>

                            <!-- Pause / Resume Round -->
                            <button id="btn-pause-round" onclick="window.togglePauseCurrentRound()" class="hidden px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 font-semibold text-sm transition-all flex items-center gap-2 cursor-pointer">
                                <i id="pause-icon" class="fa-solid fa-pause"></i> <span id="pause-text">Pause Round</span>
                            </button>

                            <!-- Time Adjustments -->
                            <div id="timer-adjust-group" class="flex items-center bg-slate-950 border border-slate-800 rounded-xl p-1 gap-1">
                                <button id="btn-time-minus" onclick="window.adjustRoundTime(-5)" title="-5 min" class="px-2.5 py-1 text-xs font-bold rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white transition-colors cursor-pointer">-5m</button>
                                <button id="btn-time-plus" onclick="window.adjustRoundTime(5)" title="+5 min" class="px-2.5 py-1 text-xs font-bold rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white transition-colors cursor-pointer">+5m</button>
                            </div>

                            <!-- Generate Next Round / Additional Round -->
                            <button id="btn-generate-next" onclick="window.generateNextRound()" class="hidden px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-extrabold text-sm shadow-lg shadow-amber-950/40 transition-all flex items-center gap-2 cursor-pointer transform hover:-translate-y-0.5">
                                <i class="fa-solid fa-forward-step"></i> <span id="generate-next-label">Generate Next Round</span>
                            </button>
                            
                            <!-- Grand Finals Trigger -->
                            <button id="btn-trigger-finals" onclick="window.triggerGrandFinals()" class="hidden px-4 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-extrabold text-sm shadow-lg shadow-purple-950/50 transition-all flex items-center gap-2 cursor-pointer">
                                <i class="fa-solid fa-crown"></i> Trigger Grand Finals
                            </button>

                            <!-- Crown The Champion Trigger -->
                            <button id="btn-crown-champion" onclick="window.crownChampion()" class="hidden px-4 py-2.5 rounded-xl bg-slate-800 text-slate-500 border border-slate-700 font-bold text-sm transition-all flex items-center gap-2 cursor-not-allowed" disabled>
                                <i class="fa-solid fa-award"></i> Crown The Champion
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tables Container -->
                <div class="relative">
                    <div id="tables-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Dynamic Tables -->
                    </div>
                </div>
            </div>

            <!-- TAB 2: STANDINGS VIEW -->
            <div id="view-standings" class="hidden bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-xl relative overflow-visible">
                <!-- Confetti Canvas Overlay -->
                <canvas id="confetti-canvas" class="absolute inset-0 pointer-events-none z-20 w-full h-full hidden"></canvas>

                <div class="flex items-center justify-between mb-4 border-b border-slate-800 pb-3 relative z-30">
                    <div>
                        <h2 class="text-lg font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-ranking-star text-amber-400"></i> Overall Tournament Leaderboard
                        </h2>
                    </div>
                    <!-- Rules Tooltip Icon -->
                    <div class="relative group">
                        <button type="button" class="p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold rounded-lg border border-slate-700 transition-colors flex items-center gap-1.5 cursor-help">
                            <i class="fa-solid fa-circle-info text-amber-400 text-sm"></i>
                            <span class="hidden sm:inline">Scoring Rules</span>
                        </button>
                        <!-- Tooltip Popup -->
                        <div class="absolute right-0 top-full mt-2 w-64 p-3 bg-slate-950 border border-slate-700 rounded-xl shadow-2xl text-xs text-slate-300 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all z-50">
                            <div class="font-bold text-amber-400 mb-1 flex items-center gap-1">
                                <i class="fa-solid fa-trophy"></i> Leaderboard Ranking Rules
                            </div>
                            <p class="leading-relaxed">
                                Ranked by Total Tournament Points (3pt 1st, 2pt 2nd, 1pt 3rd, plus 1pt per bonus earned), then VPs and HP tiebreakers.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="overflow-x-auto relative z-10">
                    <table class="w-full text-left text-sm">
                        <thead>
                            <tr class="bg-slate-950 text-slate-400 uppercase text-[11px] tracking-wider border-b border-slate-800">
                                <th class="py-3 px-4">Rank</th>
                                <th class="py-3 px-4">Player</th>
                                <th class="py-3 px-4 text-center">Played</th>
                                <th class="py-3 px-4 text-center">Wins</th>
                                <th class="py-3 px-4 text-center">Points</th>
                                <th class="py-3 px-4 text-center" title="Bonus Points">🎖️</th>
                                <th class="py-3 px-4 text-center" title="Total Victory Points">⭐</th>
                                <th class="py-3 px-4 text-center" title="Total Health Points">❤️</th>
                            </tr>
                        </thead>
                        <tbody id="standings-table-body" class="divide-y divide-slate-800/60 font-medium">
                            <!-- Populated via JS -->
                        </tbody>
                    </table>
                </div>
            </div>

        </section>
    </main>

    <!-- Footer Section -->
    <footer class="bg-slate-900 border-t border-slate-800 mt-auto text-slate-400 text-xs py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="space-y-3">
