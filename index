            let seedMax = seedMin + playerList.length - 1;
            let seedTag = isFinals ? (tableIdx === 0 ? "Championship Table" : "Consolation Pod") : (playerList.length > 0 ? `Seeds #${seedMin}-${seedMax}` : `Table ${tableNum}`);

            return {
                id: 't_' + Date.now() + '_' + tableIdx + '_' + Math.random().toString(36).substr(2, 3),
                tableNumber: tableNum,
                tableName: `Table ${tableNum}`,
                seedTag: seedTag,
                tableIcon: theme.icon,
                borderColor: theme.borderColor,
                badgeBg: theme.badgeBg,
                iconColor: theme.iconColor,
                isFinalsTable: isFinals,
                completed: false,
                seats: playerList.map(p => ({
                    playerId: p.id,
                    rank: 0,
                    vp: 0,
                    hp: 0
                }))
            };
        }

