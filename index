            card.setAttribute('ondragover', 'window.handleDragOver(event)');
            card.setAttribute('ondragleave', 'window.handleDragLeave(event)');
            card.setAttribute('ondrop', `window.handleDrop(event, '${table.id}')`);

            const takenRanks = new Set(table.seats.map(s => parseInt(s.rank)).filter(r => r > 0));

            const seatsHTML = table.seats.map((seat, sIdx) => {
                const playerObj = window.tournament.players.find(p => p.id === seat.playerId) || { name: 'Unknown' };
