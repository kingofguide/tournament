        // Standings & Scoring Calculations
        window.calculateStandings = function() {
            const stats = {};
            window.tournament.players.forEach(p => {
                stats[p.id] = {
                    id: p.id,
                    name: p.name,
                    gamesPlayed: 0,
                    wins: 0,
                    pts: 0,
                    bonusTotal: 0,
                    vpTotal: 0,
                    hpTotal: 0
                };
            });

            // Scoring rule: 3 pts for 1st, 2 pts for 2nd, 1 pt for 3rd, plus 1 pt per bonus
            const ptsLookup = [0, 3, 2, 1];

            window.tournament.rounds.forEach((round) => {
                round.tables.forEach((table) => {
                    if (round.isFinals && table.isFinalsTable === false) {
                        return;
                    }

                    if (table.completed) {
                        table.seats.forEach(seat => {
                            const p = stats[seat.playerId];
                            if (p) {
                                p.gamesPlayed += 1;
                                const rank = parseInt(seat.rank) || 0;
                                if (rank === 1) p.wins += 1;
                                const bonus = window.getBonusCount(seat);
                                p.pts += (ptsLookup[rank] || 0) + bonus;
                                p.bonusTotal += bonus;
                                p.vpTotal += (parseInt(seat.vp) || 0);
                                p.hpTotal += (parseInt(seat.hp) || 0);
                            }
                        });
                    }
                });
            });

            return Object.values(stats).sort((a, b) => {
                if (b.pts !== a.pts) return b.pts - a.pts;
                if (b.wins !== a.wins) return b.wins - a.wins;
                if (b.vpTotal !== a.vpTotal) return b.vpTotal - a.vpTotal;
                return b.hpTotal - a.hpTotal;
            });
        };

