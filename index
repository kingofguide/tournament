                    const isDisabled = (takenRanks.has(r) && currentSeatRank !== r) ? 'disabled' : '';
                    const disabledLabel = isDisabled ? ' (Taken)' : '';
                    rankOptions += `<option value="${r}" ${sel} ${isDisabled}>${r}${getOrdinalSuffix(r)}${disabledLabel}</option>`;
                }

                return `
                    <div draggable="true" 
                         ondragstart="window.handleDragStart(event, '${table.id}', '${seat.playerId}')" 
                         ondragend="window.handleDragEnd(event)"
                         class="flex flex-col gap-1 px-2 py-1.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors cursor-grab active:cursor-grabbing">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="w-5 h-5 rounded-full bg-slate-800 text-slate-400 text-[10px] font-black flex items-center justify-center shrink-0">
                                <i class="fa-solid fa-grip-vertical text-slate-600 mr-1 text-[8px]"></i>${sIdx + 1}
                            </span>
                            <span class="font-bold text-sm text-slate-100 truncate" title="${escapeHtml(playerObj.name)}">${escapeHtml(playerObj.name)}</span>
                        </div>
                        
                        <div class="flex items-center gap-1.5 flex-wrap" ondragstart="event.stopPropagation()">
                            <select onchange="window.updateSeatScore('${table.id}', '${seat.playerId}', 'rank', this.value)" ${isUnstarted ? 'disabled' : ''} class="w-[4.5rem] bg-slate-950 border border-slate-700 rounded-lg px-1.5 py-0.5 text-xs font-bold text-amber-400 focus:outline-none focus:border-amber-500 disabled:opacity-50">
                                ${rankOptions}
                            </select>
                            
                            <div title="Victory Points" class="flex items-center gap-1 bg-slate-950 border border-slate-700 rounded-lg px-1.5 py-0.5">
                                <span class="text-[11px] leading-none">⭐</span>
                                <input type="number" min="0" max="20" value="${seat.vp}" onchange="window.updateSeatScore('${table.id}', '${seat.playerId}', 'vp', this.value)" class="w-9 bg-transparent text-xs font-bold text-white text-center focus:outline-none">
                            </div>

                            <div title="Health Points" class="flex items-center gap-1 bg-slate-950 border border-slate-700 rounded-lg px-1.5 py-0.5">
                                <span class="text-[11px] leading-none">❤️</span>
                                <input type="number" min="0" max="12" value="${seat.hp}" onchange="window.updateSeatScore('${table.id}', '${seat.playerId}', 'hp', this.value)" class="w-9 bg-transparent text-xs font-bold text-white text-center focus:outline-none">
                            </div>

                            <button type="button" title="Bonuses" onclick="window.openBonusModal('${table.id}', '${seat.playerId}')" class="ml-auto flex items-center gap-1 rounded-lg px-1.5 py-0.5 border text-xs font-bold transition-colors cursor-pointer ${bonusCount > 0 ? 'bg-amber-500/15 border-amber-500/40 text-amber-300 hover:bg-amber-500/25' : 'bg-slate-950 border-slate-700 text-slate-400 hover:border-amber-500/50 hover:text-amber-300'}">
                                <span class="text-[11px] leading-none">🎖️</span><span>Bonuses</span>${bonusCount > 0 ? `<span class="text-[10px] font-black">+${bonusCount}</span>` : ''}
                            </button>
                        </div>
                    </div>
                `;
            }).join('');

            card.innerHTML = `
                <div>
                    <div class="flex items-center justify-between mb-2 border-b border-slate-800 pb-2">
                        <div class="flex items-center gap-2 min-w-0">
                            <h3 class="font-extrabold text-sm text-white flex items-center gap-1.5 truncate">
                                <i class="fa-solid ${tableIcon} ${iconColor} shrink-0"></i> <span class="truncate">${escapeHtml(tableTitle)}</span>
                            </h3>
                            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded border ${badgeBg} shrink-0">${seedTag}</span>
                        </div>
                        
                        <div class="flex items-center gap-2 shrink-0">
                            ${table.completed ? 
                                `<span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-bold uppercase"><i class="fa-solid fa-circle-check mr-1"></i> Submitted</span>` :
                                `<span class="px-2 py-0.5 rounded-full bg-slate-900 text-slate-400 border border-slate-800 text-[10px] font-bold uppercase">In Play</span>`
                            }
                        </div>
                    </div>

                    <div class="space-y-1.5 mb-3">
                        ${seatsHTML}
                    </div>
                </div>

                <div class="pt-2 border-t border-slate-900 flex items-center justify-between gap-2">
                    <button onclick="window.toggleTableComplete('${table.id}')" ${isUnstarted ? 'disabled' : ''} class="flex-1 py-2 rounded-xl ${table.completed ? 'bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800' : 'bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-950/40'} font-bold text-xs transition-all flex items-center justify-center gap-1.5 cursor-pointer disabled:opacity-50">
                        <i class="fa-solid ${table.completed ? 'fa-pen-to-square' : 'fa-check'}"></i> ${table.completed ? 'Unlock Table Results' : 'Submit Table Results'}
                    </button>
                </div>
            `;

            return card;
        }

        // Drag and Drop Event Handlers
        window.handleDragStart = function(event, tableId, playerId) {
            draggedPlayerInfo = { tableId, playerId };
            event.currentTarget.classList.add('dragging');
            event.dataTransfer.setData('text/plain', JSON.stringify(draggedPlayerInfo));
            event.dataTransfer.effectAllowed = 'move';
        };

        window.handleDragEnd = function(event) {
            event.currentTarget.classList.remove('dragging');
            draggedPlayerInfo = null;
        };

        window.handleDragOver = function(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            event.currentTarget.classList.add('drag-over');
        };

        window.handleDragLeave = function(event) {
            event.currentTarget.classList.remove('drag-over');
        };

        window.handleDrop = function(event, targetTableId) {
            event.preventDefault();
            event.currentTarget.classList.remove('drag-over');

            if (!draggedPlayerInfo) return;

            const { tableId: sourceTableId, playerId } = draggedPlayerInfo;
            if (sourceTableId === targetTableId) return;

            const currentRound = window.tournament.rounds[window.tournament.currentRound];
            const sourceTable = currentRound.tables.find(t => t.id === sourceTableId);
            const targetTable = currentRound.tables.find(t => t.id === targetTableId);

            if (!sourceTable || !targetTable) return;

            const seatIdx = sourceTable.seats.findIndex(s => s.playerId === playerId);
            if (seatIdx === -1) return;
            const [movedSeat] = sourceTable.seats.splice(seatIdx, 1);

            targetTable.seats.push(movedSeat);

            window.saveTournament();
            window.renderAll();

            const playerObj = window.tournament.players.find(p => p.id === playerId);
            const name = playerObj ? playerObj.name : 'Player';
            window.showToast(`Moved ${name} to ${targetTable.tableName}`, "success");
        };

        window.updateSeatScore = function(tableId, playerId, field, value) {
            const currentRound = window.tournament.rounds[window.tournament.currentRound];
            const table = currentRound.tables.find(t => t.id === tableId);
            if (!table) return;

            const seat = table.seats.find(s => s.playerId === playerId);
            if (seat) {
                if (field === 'vp') {
                    seat[field] = Math.min(20, Math.max(0, parseInt(value) || 0));
                } else if (field === 'hp') {
                    seat[field] = Math.min(12, Math.max(0, parseInt(value) || 0));
                } else {
                    seat[field] = parseInt(value) || 0;
                }
            }

            const allRanksAssigned = table.seats.length > 0 && table.seats.every(s => parseInt(s.rank) > 0);
            if (allRanksAssigned && !table.completed) {
                table.completed = true;
                window.showToast(`All ranks entered! ${table.tableName} results auto-submitted.`, "success");
            }

            window.saveTournament();
            checkAndAutoPauseRound();
            window.renderAll();
        };

        window.toggleTableComplete = function(tableId) {
            const currentRound = window.tournament.rounds[window.tournament.currentRound];
            const table = currentRound.tables.find(t => t.id === tableId);
            if (!table) return;

            table.completed = !table.completed;
            window.saveTournament();
            checkAndAutoPauseRound();
            window.renderAll();
            window.showToast(table.completed ? `${table.tableName} results locked!` : `${table.tableName} unlocked for edits.`, "info");
        };

        function checkAndAutoPauseRound() {
            const currentRound = window.tournament.rounds[window.tournament.currentRound];
            if (!currentRound || !currentRound.started) return;

            const allTablesDone = currentRound.tables.length > 0 && currentRound.tables.every(t => t.completed);
            if (allTablesDone) {
                isRoundActive = false;
                window.showToast("All tables completed! Round timer stopped.", "success");
            }
        }

        window.selectRound = function(idx) {
            window.tournament.currentRound = idx;
            window.saveTournament();
            window.switchTab('rounds');
            window.renderRoundsUI();
        };

        // Navigation Tabs Switcher
        window.switchTab = function(tab) {
            const roundsView = document.getElementById('view-rounds');
            const standingsView = document.getElementById('view-standings');
            const tabBtnRounds = document.getElementById('tab-btn-rounds');
            const tabBtnStandings = document.getElementById('tab-btn-standings');

            if (tab === 'rounds') {
                roundsView.classList.remove('hidden');
                standingsView.classList.add('hidden');
                tabBtnRounds.className = "px-4 py-2 text-sm font-bold rounded-xl bg-amber-500 text-slate-950 transition-all flex items-center gap-2 shadow-lg cursor-pointer";
                tabBtnStandings.className = "px-4 py-2 text-sm font-bold rounded-xl bg-slate-800 text-slate-400 hover:text-white transition-all flex items-center gap-2 cursor-pointer";
            } else {
                roundsView.classList.add('hidden');
                standingsView.classList.remove('hidden');
                tabBtnRounds.className = "px-4 py-2 text-sm font-bold rounded-xl bg-slate-800 text-slate-400 hover:text-white transition-all flex items-center gap-2 cursor-pointer";
                tabBtnStandings.className = "px-4 py-2 text-sm font-bold rounded-xl bg-amber-500 text-slate-950 transition-all flex items-center gap-2 shadow-lg cursor-pointer";
                window.renderStandings();
            }
        };

        // Overall Render Controller
        window.renderAll = function() {
            window.renderRoster();
            window.renderRoundsUI();
            window.renderStandings();
        };

        window.renderRoundsUI = function() {
            const container = document.getElementById('tables-container');
            const roundHeader = document.getElementById('round-header');
            const roundPills = document.getElementById('round-pills-container');
            const sidebarSection = document.getElementById('sidebar-setup-section');
            const mainSection = document.getElementById('main-content-section');
            
            const hasTournamentStarted = window.tournament.rounds.length > 0;
            // On mobile (< 1024px), move setup sidebar below main content once started. On desktop, sidebar stays on the left (lg:order-1).
            if (hasTournamentStarted) {
                sidebarSection.classList.remove('lg:order-1');
                sidebarSection.classList.add('order-2', 'lg:order-1');
                mainSection.classList.remove('lg:order-2');
                mainSection.classList.add('order-1', 'lg:order-2');
            } else {
                sidebarSection.classList.remove('order-2');
                sidebarSection.classList.add('order-2', 'lg:order-1');
                mainSection.classList.add('order-1', 'lg:order-2');
            }

            roundPills.innerHTML = window.tournament.rounds.map((r, idx) => {
                const isFinalsRound = r.isFinals;
                const label = isFinalsRound ? `<i class="fa-solid fa-crown text-amber-400 mr-1"></i> Finals` : `R${idx + 1}`;
                const activeStyle = idx === window.tournament.currentRound 
                    ? 'bg-amber-500 text-slate-950 font-black shadow-lg shadow-amber-500/25' 
                    : 'bg-slate-800 text-slate-400 hover:text-white font-extrabold';
                return `
                    <button onclick="window.selectRound(${idx})" class="px-3 py-1.5 text-xs rounded-xl whitespace-nowrap transition-all cursor-pointer flex items-center gap-1.5 ${activeStyle}">
                        ${label}
                    </button>
                `;
            }).join('');

            if (window.tournament.rounds.length === 0) {
                roundHeader.classList.add('hidden');
                container.innerHTML = `<div class="col-span-2 text-center py-16 text-slate-500 bg-slate-900/40 rounded-2xl border border-slate-800 border-dashed">
                    <i class="fa-solid fa-dice-d6 text-4xl mb-3 opacity-40 text-amber-500"></i>
                    <p class="text-base font-bold text-slate-300">No rounds generated yet.</p>
                    <p class="text-xs text-slate-500 mt-1">Add your players on the left and click <strong>Generate Tournament</strong> to launch!</p>
                </div>`;
                return;
            }

            roundHeader.classList.remove('hidden');
            const currentRoundIndex = window.tournament.currentRound;
            const roundData = window.tournament.rounds[currentRoundIndex];

            const isRoundStarted = roundData.started || false;
            
            document.getElementById('round-title-display').innerText = roundData.name || `Round ${currentRoundIndex + 1}`;
            updateTimerDisplay(roundData.timerRemaining || 1800);

            const btnStart = document.getElementById('btn-start-round');
            const btnPause = document.getElementById('btn-pause-round');
            const pauseIcon = document.getElementById('pause-icon');
            const pauseText = document.getElementById('pause-text');
            const btnGenerateNext = document.getElementById('btn-generate-next');
            const btnFinals = document.getElementById('btn-trigger-finals');
            const btnCrownChampion = document.getElementById('btn-crown-champion');
            const statusBadge = document.getElementById('round-status-badge');
            const timeMinusBtn = document.getElementById('btn-time-minus');
            const timePlusBtn = document.getElementById('btn-time-plus');

            const maxPrelimRounds = window.tournament.settings.maxRounds;
            const currentRoundNumber = currentRoundIndex + 1;
            const isGrandFinalsRound = roundData.isFinals;
            const isLatestRound = currentRoundIndex === window.tournament.rounds.length - 1;
            const isAllCompleted = roundData.tables.length > 0 && roundData.tables.every(t => t.completed);

            if (isAllCompleted) {
                timeMinusBtn.classList.add('opacity-40', 'pointer-events-none');
                timePlusBtn.classList.add('opacity-40', 'pointer-events-none');
            } else {
                timeMinusBtn.classList.remove('opacity-40', 'pointer-events-none');
                timePlusBtn.classList.remove('opacity-40', 'pointer-events-none');
            }

            if (!isRoundStarted) {
                statusBadge.innerText = 'Waiting to Start';
                statusBadge.className = 'px-2.5 py-0.5 text-xs font-bold rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/30 uppercase tracking-wider';

                btnStart.classList.remove('hidden');
                btnPause.classList.add('hidden');

                btnGenerateNext.classList.add('hidden');
                btnFinals.classList.add('hidden');
                btnCrownChampion.classList.add('hidden');
            } else {
                btnStart.classList.add('hidden');
                btnPause.classList.remove('hidden');

                if (isRoundActive) {
                    statusBadge.innerText = 'In Progress';
                    statusBadge.className = 'px-2.5 py-0.5 text-xs font-bold rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 uppercase tracking-wider animate-pulse';
                    pauseIcon.className = "fa-solid fa-pause";
                    pauseText.innerText = "Pause Round";
                } else if (isAllCompleted) {
                    statusBadge.innerText = 'Completed';
                    statusBadge.className = 'px-2.5 py-0.5 text-xs font-bold rounded-full bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 uppercase tracking-wider';
                    pauseIcon.className = "fa-solid fa-play";
                    pauseText.innerText = "Resume Round";
                } else {
                    statusBadge.innerText = 'Paused';
                    statusBadge.className = 'px-2.5 py-0.5 text-xs font-bold rounded-full bg-slate-800 text-slate-400 border border-slate-700 uppercase tracking-wider';
                    pauseIcon.className = "fa-solid fa-play";
                    pauseText.innerText = "Resume Round";
                }

                if (isAllCompleted && !isGrandFinalsRound) {
                    if (isLatestRound) {
                        const isFinalsTriggered = roundData.finalsTriggered || false;
                        const isNextRoundGenerated = roundData.nextRoundGenerated || false;

                        if (!isFinalsTriggered) {
                            btnFinals.classList.remove('hidden');
                            btnFinals.className = "px-4 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-extrabold text-sm shadow-lg shadow-purple-950/50 transition-all flex items-center gap-2 cursor-pointer transform hover:-translate-y-0.5";
                        } else {
                            btnFinals.classList.add('hidden');
                        }

                        if (!isNextRoundGenerated) {
                            if (currentRoundNumber < maxPrelimRounds) {
                                document.getElementById('generate-next-label').innerText = "Generate Next Round";
                                btnGenerateNext.classList.remove('hidden');
                                btnGenerateNext.className = "px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-extrabold text-sm shadow-lg shadow-amber-950/40 transition-all flex items-center gap-2 cursor-pointer transform hover:-translate-y-0.5";
                            } else {
                                document.getElementById('generate-next-label').innerText = "Add Additional Round";
                                btnGenerateNext.classList.remove('hidden');
                                btnGenerateNext.className = "px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-amber-400 border border-slate-700 font-semibold text-sm transition-all flex items-center gap-2 cursor-pointer";
                            }
                        } else {
                            btnGenerateNext.classList.add('hidden');
                        }
                    } else {
                        btnFinals.classList.add('hidden');
                        btnGenerateNext.classList.add('hidden');
                    }
                    btnCrownChampion.classList.add('hidden');
                } else if (isAllCompleted && isGrandFinalsRound) {
                    btnGenerateNext.classList.add('hidden');
                    btnFinals.classList.add('hidden');
                    
                    if (isLatestRound) {
                        btnCrownChampion.classList.remove('hidden');
                        btnCrownChampion.className = "px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-sm shadow-xl shadow-amber-950/60 transition-all flex items-center gap-2 cursor-pointer transform hover:-translate-y-0.5";
                        btnCrownChampion.removeAttribute('disabled');
                    } else {
                        btnCrownChampion.classList.add('hidden');
                    }
                } else {
                    btnGenerateNext.classList.add('hidden');
                    btnFinals.classList.add('hidden');
                    btnCrownChampion.classList.add('hidden');
                }
            }

            container.innerHTML = '';
            roundData.tables.forEach((table) => {
                container.appendChild(createTableCard(table, currentRoundIndex));
            });
        };

        // Application Initialization
        window.onload = function() {
            window.loadTournament();
            window.syncSettingsUI();
            window.renderAll();
        };
    </script>
</body>
</html>
