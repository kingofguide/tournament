            { icon: 'fa-cat', borderColor: 'border-pink-500/40', badgeBg: 'bg-pink-500/20 text-pink-300 border-pink-500/30', iconColor: 'text-pink-400' },
            { icon: 'fa-robot', borderColor: 'border-sky-500/40', badgeBg: 'bg-sky-500/20 text-sky-300 border-sky-500/30', iconColor: 'text-sky-400' },
            { icon: 'fa-spider', borderColor: 'border-fuchsia-500/40', badgeBg: 'bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-500/30', iconColor: 'text-fuchsia-400' },
            { icon: 'fa-dinosaur', borderColor: 'border-emerald-600/40', badgeBg: 'bg-emerald-600/20 text-emerald-200 border-emerald-600/30', iconColor: 'text-emerald-500' },
            { icon: 'fa-hand-fist', borderColor: 'border-amber-600/40', badgeBg: 'bg-amber-600/20 text-amber-200 border-amber-600/30', iconColor: 'text-amber-500' },
            { icon: 'fa-radiation', borderColor: 'border-yellow-400/40', badgeBg: 'bg-yellow-400/20 text-yellow-200 border-yellow-400/30', iconColor: 'text-yellow-300' },
            { icon: 'fa-explosion', borderColor: 'border-rose-600/40', badgeBg: 'bg-rose-600/20 text-rose-200 border-rose-600/30', iconColor: 'text-rose-500' },
            { icon: 'fa-eye', borderColor: 'border-violet-500/40', badgeBg: 'bg-violet-500/20 text-violet-300 border-violet-500/30', iconColor: 'text-violet-400' },
            { icon: 'fa-locust', borderColor: 'border-green-500/40', badgeBg: 'bg-green-500/20 text-green-300 border-green-500/30', iconColor: 'text-green-400' },
            { icon: 'fa-hat-wizard', borderColor: 'border-purple-600/40', badgeBg: 'bg-purple-600/20 text-purple-200 border-purple-600/30', iconColor: 'text-purple-400' },
            { icon: 'fa-fish-fins', borderColor: 'border-cyan-600/40', badgeBg: 'bg-cyan-600/20 text-cyan-200 border-cyan-600/30', iconColor: 'text-cyan-400' },
            { icon: 'fa-crown', borderColor: 'border-amber-400/60', badgeBg: 'bg-amber-400/20 text-amber-300 border-amber-400/30', iconColor: 'text-amber-400' }
        ];

        // Header Dropdown Menu Controls
        window.toggleHeaderMenu = function(event) {
            if (event) event.stopPropagation();
            const menu = document.getElementById('header-dropdown-menu');
            if (menu) {
                menu.classList.toggle('hidden');
            }
        };

        window.closeHeaderMenu = function() {
            const menu = document.getElementById('header-dropdown-menu');
            if (menu && !menu.classList.contains('hidden')) {
                menu.classList.add('hidden');
            }
        };

        // Close dropdown when clicking anywhere outside
        document.addEventListener('click', function(event) {
            const menu = document.getElementById('header-dropdown-menu');
            if (menu && !menu.classList.contains('hidden')) {
                menu.classList.add('hidden');
            }
        });

        // Rules Modal Controls
        window.openRulesModal = function() {
            document.getElementById('rules-modal').classList.remove('hidden');
        };

        window.closeRulesModal = function() {
            document.getElementById('rules-modal').classList.add('hidden');
        };

        // Global Tournament State
        window.tournament = {
            settings: {
                tableSize: 5,
                maxRounds: 3,
                roundTimerMinutes: 30
            },
            players: [],
            rounds: [],
            currentRound: 0
        };

        let globalTimerInterval = null;
        let isRoundActive = false;
        let draggedPlayerInfo = null;

        // Persistence & Storage
        window.saveTournament = function() {
            try {
                localStorage.setItem('kot_tournament_state', JSON.stringify(window.tournament));
            } catch(e) {
                console.error('Storage error:', e);
            }
        };

        window.loadTournament = function() {
            try {
                const saved = localStorage.getItem('kot_tournament_state');
                if (saved) {
                    window.tournament = JSON.parse(saved);
                    window.applySettingsToUI();
                }
            } catch(e) {
                console.error('Load error:', e);
            }
        };

        window.openResetModal = function() {
            document.getElementById('reset-modal').classList.remove('hidden');
        };

        window.closeResetModal = function() {
            document.getElementById('reset-modal').classList.add('hidden');
        };

        window.executeResetTournament = function() {
            if (globalTimerInterval) clearInterval(globalTimerInterval);
            globalTimerInterval = null;
            isRoundActive = false;
            window.tournament = {
                settings: {
                    tableSize: parseInt(document.getElementById('setting-table-size').value) || 5,
                    maxRounds: parseInt(document.getElementById('setting-max-rounds').value) || 3,
                    roundTimerMinutes: parseInt(document.getElementById('setting-round-timer').value) || 30
                },
                players: [],
                rounds: [],
                currentRound: 0
            };
            window.saveTournament();
            window.closeResetModal();
            window.renderAll();
            window.showToast("Tournament reset successfully.", "info");
        };

        let settingsToastTimer = null;

        const SETTING_LIMITS = {
            'setting-table-size': { min: 2, max: 6, def: 5 },
            'setting-max-rounds': { min: 1, max: 5, def: 3 },
            'setting-round-timer': { min: 5, max: 60, def: 30 }
        };

        function readSetting(id) {
            const lim = SETTING_LIMITS[id];
            const input = document.getElementById(id);
            let v = parseInt(input.value);
            if (isNaN(v)) v = lim.def;
            return Math.max(lim.min, Math.min(lim.max, v));
        }

        // Keeps slider fill, value badges and the round-count buttons in step with the inputs
        window.syncSettingsUI = function() {
            ['setting-table-size', 'setting-round-timer'].forEach(id => {
                const el = document.getElementById(id);
                const lim = SETTING_LIMITS[id];
                const pct = ((readSetting(id) - lim.min) / (lim.max - lim.min)) * 100;
                el.style.setProperty('--pct', pct + '%');
            });
            document.getElementById('badge-table-size').textContent = readSetting('setting-table-size');
            document.getElementById('badge-round-timer').textContent = readSetting('setting-round-timer') + ' min';
            const rounds = readSetting('setting-max-rounds');
            document.getElementById('badge-max-rounds').textContent = rounds + (rounds === 1 ? ' round' : ' rounds');
            document.querySelectorAll('.round-opt').forEach(btn => {
                const active = parseInt(btn.dataset.rounds) === rounds;
                btn.className = 'round-opt flex flex-col items-center gap-1 py-2 rounded-xl border transition-colors cursor-pointer ' +
                    (active ? 'bg-amber-500 border-amber-400 text-slate-950 shadow-lg shadow-amber-500/20'
                            : 'bg-slate-950 border-slate-800 text-slate-400 hover:border-amber-500/50 hover:text-amber-300');
            });
        };

        // Push stored settings back into the controls (load / import)
        window.applySettingsToUI = function() {
            const st = window.tournament.settings;
            if (!st) { window.syncSettingsUI(); return; }
            document.getElementById('setting-table-size').value = st.tableSize || 5;
            document.getElementById('setting-max-rounds').value = st.maxRounds || 3;
            document.getElementById('setting-round-timer').value = st.roundTimerMinutes || 30;
            window.syncSettingsUI();
        };

        window.updateSettings = function() {
            window.tournament.settings.tableSize = readSetting('setting-table-size');
            window.tournament.settings.maxRounds = readSetting('setting-max-rounds');
            window.tournament.settings.roundTimerMinutes = readSetting('setting-round-timer');
            window.syncSettingsUI();
            window.saveTournament();
            // Debounce the toast so dragging a slider only notifies once, after the last change
            clearTimeout(settingsToastTimer);
            settingsToastTimer = setTimeout(() => window.showToast("Settings updated", "info"), 800);
        };

        window.setPrelimRounds = function(n) {
            document.getElementById('setting-max-rounds').value = n;
            window.updateSettings();
        };

        window.showToast = function(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let bg = 'bg-slate-900 border-slate-700 text-slate-200';
            let icon = 'fa-circle-info text-blue-400';
            if (type === 'success') {
                bg = 'bg-emerald-950/90 border-emerald-500/40 text-emerald-200';
                icon = 'fa-circle-check text-emerald-400';
            } else if (type === 'error') {
                bg = 'bg-rose-950/90 border-rose-500/40 text-rose-200';
                icon = 'fa-triangle-exclamation text-rose-400';
            }

            toast.className = `px-4 py-3 rounded-xl border shadow-xl flex items-center gap-3 text-xs font-bold transition-all transform translate-y-2 opacity-0 ${bg}`;
            toast.innerHTML = `<i class="fa-solid ${icon} text-base"></i><span>${escapeHtml(message)}</span>`;
            
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        };

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        window.exportTournamentData = function() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(window.tournament, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `King_Of_Tokyo_Tournament_${Date.now()}.json`);
